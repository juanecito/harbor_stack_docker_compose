HARBOR_VERSION=v2.15.2

# Acceso solo desde localhost: el resto de máquinas llega por túnel SSH
# (ssh -N -L 443:127.0.0.1:443 -L 80:127.0.0.1:80 usuario@servidor; ver README).
# Todos (servidor y clientes del túnel) usan la misma URL, https://localhost, que es la
# que Harbor da a docker para pedir el token: si no coincide, `docker login` falla.
#
# Para abrirlo a la red: HARBOR_HOSTNAME=<nombre DNS o IP>, HARBOR_EXTERNAL_URL=https://<el mismo>
# y quita el 127.0.0.1: de los puertos (o pon la IP de la interfaz por la que escuchar).

# Nombre (DNS o IP) con el que los clientes acceden a Harbor (certificado autofirmado)
HARBOR_HOSTNAME=localhost
# URL pública; añade el puerto si HARBOR_HTTPS_PORT no es 443
HARBOR_EXTERNAL_URL=https://localhost

# Puertos publicados en el host, ligados solo a la interfaz de loopback
HARBOR_HTTP_PORT=127.0.0.1:80
HARBOR_HTTPS_PORT=127.0.0.1:443

# Directorio del host para datos persistentes (registry, BD, redis, secretos...)
HARBOR_DATA_DIR=./data

LOG_LEVEL=info

# --- Secretos: ./generate-env.sh los rellena con valores aleatorios ---
HARBOR_ADMIN_PASSWORD=
DB_PASSWORD=
REGISTRY_PASSWORD=
CORE_SECRET=
JOBSERVICE_SECRET=
CSRF_KEY=
ROBOT_SCANNER_NAME_PREFIX=
APTLY_API_PASSWORD=

# --- Repositorio Debian (aptly) ---
APTLY_API_USER=aptly
# Identidad de la clave GPG de firma (solo se usa al generarla, en el primer arranque)
APTLY_GPG_NAME=Aptly Debian repository
APTLY_GPG_EMAIL=debian@example.com

# --- Opcional ---
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=127.0.0.1,localhost,.local,.internal,core,portal,postgresql,jobservice,registry,registryctl,redis,trivy-adapter,nginx
# TRIVY_GITHUB_TOKEN=
